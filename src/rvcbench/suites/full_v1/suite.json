{
  "suite": "full-v1",
  "version": 1,
  "leaderboard": false,
  "label": "RVCBench-Full preview: data and protocol under review. Scores are not leaderboard results.",
  "paper": "https://arxiv.org/abs/2602.00443",
  "hf_dataset_id": "Nanboy/RVCBench",
  "hf_revision": "a932bd08d6858f14bdda52356dde5a7b771f0245",
  "evaluation": {
    "required_metrics": [
      "sim",
      "speechmos",
      "wer",
      "mcd"
    ],
    "wer_normalization": "ascii_punctuation_removed_v2",
    "generated_audio_max_seconds": null,
    "seed": 42,
    "bootstrap": {
      "enabled": true,
      "num_samples": 1000,
      "confidence_level": 0.95,
      "seed": null
    }
  },
  "not_included": {
    "RVC-Detectability/GroundTruth, Deepfake": "deepfake detectors are not yet part of this package (planned for core-v1.1)",
    "RVC-Expression/Persuasion EmTXT": "the audio-LLM emotion-alignment judge is planned for core-v1.1; EMC is reported",
    "RVC-AdvNoise, RVC-AntiProtect": "the protected references of every LibriTTS prompt are not yet in the Hub dataset; core-v1 covers these evaluations"
  },
  "tasks": [
